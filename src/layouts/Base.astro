---
/**
 * The document every route shares: head, the grain layer, and the mount point
 * the orchestrator's element lookups assume is always on the page. Routes
 * differ only in which screen they start on — `initialScreen()` reads
 * `location.pathname` for that.
 */
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Photobooth — two cameras, one little memory',
  description = 'A private photobooth for two people in different places. Two cameras, one little memory.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe9dd" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23efe9dd'/%3E%3Crect x='4' y='8' width='24' height='16' fill='none' stroke='%2314120e' stroke-width='3'/%3E%3Ccircle cx='16' cy='16' r='5' fill='none' stroke='%23e8380d' stroke-width='3'/%3E%3C/svg%3E"
    />

    <style>
      html {
        background: #efe9dd;
      }
    </style>

    <slot name="head" />
  </head>

  <body>
    <div class="grain" aria-hidden="true"></div>
    <main id="app">
      <slot />
    </main>

    <script is:inline>
      /* Before the bundle boots: show the screen this URL starts on, so a deep
         link doesn't flash the landing page first. Booth takes over from here. */
      (function () {
        var path = location.pathname.replace(/\/+$/, '') || '/';
        var code = new URLSearchParams(location.search).get('room');
        var screen = 'screen-landing';
        if (path === '/create') screen = 'screen-create';
        else if (path === '/strip') screen = 'screen-result';
        else if (path === '/room' || path.indexOf('/room/') === 0 || code) screen = 'screen-join';
        var target = document.getElementById(screen);
        if (!target) return;
        var active = document.querySelectorAll('.screen.is-active');
        for (var i = 0; i < active.length; i += 1) active[i].classList.remove('is-active');
        target.classList.add('is-active');
      })();
    </script>

    <noscript>
      <div style="padding: 2rem; font-family: system-ui, sans-serif; text-align: center">
        This photobooth needs JavaScript to open the camera and connect you to your partner.
      </div>
    </noscript>
  </body>
</html>
