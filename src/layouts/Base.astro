---
/**
 * The document every route shares: head, the grain layer, and the mount point
 * the orchestrator's element lookups assume is always on the page. Routes
 * differ only in which screen they start on — `initialScreen()` reads
 * `location.pathname` for that.
 */
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Photobooth — two cameras, one little memory',
  description = 'A private photobooth for two people in different places. Two cameras, one little memory.',
} = Astro.props;

// Served from this origin instead of fonts.googleapis.com: nothing to fetch
// from a third party, nothing to block first paint, and the booth keeps its
// faces even with no internet. Only the weights the stylesheet actually asks
// for — Anton 400, Space Grotesk 400/500/700, Space Mono 400/700.
import '@fontsource/anton/400.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf1f4" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23fdf1f4'/%3E%3Crect x='4' y='8' width='24' height='16' fill='none' stroke='%233d1f2a' stroke-width='3'/%3E%3Ccircle cx='16' cy='16' r='5' fill='none' stroke='%23e0457b' stroke-width='3'/%3E%3C/svg%3E"
    />

    <style>
      html {
        background: var(--paper);
      }
    </style>

    <slot name="head" />
  </head>

  <body>
    <div class="grain" aria-hidden="true"></div>
    <main id="app">
      <slot />
    </main>

    <script is:inline>
      /* Before the bundle boots: show the screen this URL starts on, so a deep
         link doesn't flash the landing page first. Booth takes over from here. */
      (function () {
        var path = location.pathname.replace(/\/+$/, '') || '/';
        var code = new URLSearchParams(location.search).get('room');
        var screen = 'screen-landing';
        if (path === '/create') screen = 'screen-create';
        else if (path === '/strip') screen = 'screen-result';
        else if (path === '/room' || path.indexOf('/room/') === 0 || code) screen = 'screen-join';
        var target = document.getElementById(screen);
        if (!target) return;
        var active = document.querySelectorAll('.screen.is-active');
        for (var i = 0; i < active.length; i += 1) active[i].classList.remove('is-active');
        target.classList.add('is-active');
      })();
    </script>

    <noscript>
      <div style="padding: 2rem; font-family: system-ui, sans-serif; text-align: center">
        This photobooth needs JavaScript to open the camera and connect you to your partner.
      </div>
    </noscript>

    <script>
      // Offline is a real state for a booth: a room that loses signal should
      // still open. Registration is skipped on plain http — a LAN preview is
      // not a secure context, so it must never be attempted there.
      if ('serviceWorker' in navigator && window.isSecureContext) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
