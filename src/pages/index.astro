---
import Base from '../layouts/Base.astro';
import Photobooth from '../components/Photobooth.astro';
---

<Base>
  <script slot="head" is:inline>
    // Share links written before the routes existed still look like /?room=8F3K.
    (function () {
      var code = new URLSearchParams(location.search).get('room');
      if (code && location.pathname === '/') {
        location.replace('/room/' + encodeURIComponent(code.replace(/[^a-z0-9]/gi, '')));
      }
    })();
  </script>

  <Photobooth />
</Base>
