---
/**
 * CameraPermission — the moment before the lens opens.
 */
---

<section class="screen perm" id="screen-permission" aria-labelledby="perm-title">
  <div class="corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <div class="perm__lens" id="perm-lens" aria-hidden="true"></div>

  <p class="eyebrow" id="perm-kicker">Lens check</p>

  <h2 id="perm-title">Camera access</h2>

  <p id="perm-body">Your camera is needed to enter the booth. Nothing is recorded until you press capture.</p>

  <button class="btn btn--solid" type="button" data-action="enable-camera" id="perm-action">
    Enable camera
  </button>

  <p class="perm__note" id="perm-note">Video only · microphone never requested</p>

  <p class="privacy">Photos stay between you and your partner</p>
</section>
