---
/**
 * Countdown — dramatic, minimal, shared by both booths.
 */
---

<div class="countdown" id="countdown" hidden aria-live="assertive" aria-atomic="true">
  <div class="countdown__stack">
    <span class="countdown__num" id="countdown-num">3</span>
    <span class="countdown__sub" id="countdown-sub">Synchronizing</span>
  </div>
</div>

<div class="flash" id="flash" aria-hidden="true"></div>
