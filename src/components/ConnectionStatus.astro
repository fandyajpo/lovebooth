---
/**
 * ConnectionStatus — one dot, one line, always honest.
 */
---

<p class="status" id="connection-status" data-tone="waiting" role="status" aria-live="polite">
  <span class="status__dot" aria-hidden="true"></span>
  <span class="status__text" id="connection-text">Waiting for your partner</span>
</p>
