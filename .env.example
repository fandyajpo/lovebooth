# Optional. Point this at any tiny WebSocket signaling relay and the app works
# across devices. Leave unset to use the in-browser BroadcastChannel transport
# (same device, multiple tabs) which needs no server at all.
#
#   npm run relay     # starts a local relay on ws://localhost:8787
#   npm run dev
#
# PUBLIC_SIGNALING_URL=ws://localhost:8787
