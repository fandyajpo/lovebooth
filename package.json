{
  "name": "lovebooth",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A remote two-person photobooth. Two cameras, one little memory.",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "relay": "wrangler dev --port 8787 --config relay/wrangler.jsonc",
    "relay:deploy": "wrangler deploy --config relay/wrangler.jsonc"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.140.0"
  }
}
