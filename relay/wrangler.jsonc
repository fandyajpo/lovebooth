{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lovebooth-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOTH",
        "class_name": "BoothHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoothHub"]
    }
  ]
}
